# Sits between the dedicated wealth-me-up Cloudflare Tunnel and the app
# container. The app (app/chatgpt-auth.ts) trusts the oai-authenticated-user-*
# request headers unconditionally, exactly like it would behind OpenAI Sites.
# Cloudflare Access is the thing actually authenticating the human — it
# blocks any request that isn't signed in at Cloudflare's edge, before it
# ever reaches this box, and it sets Cf-Access-Authenticated-User-Email on
# what it forwards (a header clients cannot themselves spoof while Access
# enforces the app). This proxy's only job: overwrite whatever the client
# sent in the oai-authenticated-user-* namespace with the Access-verified
# email, dropping the rest.
#
# IMPORTANT — verified against Caddy 2 behavior directly (docker run test):
# a bare `header_up Name value` is a SET (overwrites any client-supplied
# value of that name), not an ADD. Do NOT also add `header_up -Name` for a
# field you're setting in the same block — Caddy applies deletions after
# sets, so a delete + set pair on the same header name silently cancels the
# set and the header never reaches the app. Use plain sets for id/email
# below; delete-only is fine for the unused full-name fields since nothing
# else touches them.
:80 {
	encode gzip
	# The tunnel must also enable Protect with Access (JWT verification).
	# All authenticated users are allowed; portfolio ownership stays per email.
	@missingIdentity not header Cf-Access-Authenticated-User-Email *@*
	respond @missingIdentity "Forbidden" 403
	@missingJWT not header Cf-Access-Jwt-Assertion *
	respond @missingJWT "Forbidden" 403
	redir /signout-with-chatgpt /cdn-cgi/access/logout 302
	redir /signin-with-chatgpt / 302

	reverse_proxy wealth-me-up-web:8787 {
		header_up -Oai-Authenticated-User-Full-Name
		header_up -Oai-Authenticated-User-Full-Name-Encoding

		header_up Oai-Authenticated-User-Id {http.request.header.Cf-Access-Authenticated-User-Email}
		header_up Oai-Authenticated-User-Email {http.request.header.Cf-Access-Authenticated-User-Email}
	}
}
